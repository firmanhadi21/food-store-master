# Node / Vite
node_modules/
dist/
*.local

# Data files（生データ・再生成可能）
data/
input/
output/
*.parquet
*.geojson
*.tsv

# PMTiles は原則コミットしないが、公開用は viewer/public/ に置いてコミットする
*.pmtiles
!viewer/public/*.pmtiles

# Semarang 公開マップの配信データはコミットする（GitHub Actions のビルド入力になるため）。
# 上の data/ と *.geojson に食われるので二段で打ち消す。git は除外された**ディレクトリ**の
# 中身を再包含できないので、先にディレクトリを外してからファイルを外す。
!viewer-semarang/public/data/
!viewer-semarang/public/data/*.geojson
!viewer-semarang/public/data/*.json

# Python
__pycache__/
*.pyc
venv/

# OS
.DS_Store
Thumbs.db
