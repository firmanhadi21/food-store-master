# Node / Vite
node_modules/
dist/
*.local

# Data files (raw inputs and regenerable outputs)
data/
input/
output/
*.parquet
*.geojson
*.tsv

# PMTiles are normally not committed; the published ones live in viewer/public/
*.pmtiles
!viewer/public/*.pmtiles

# The Semarang map's published data IS committed — GitHub Actions needs it as build input.
# It is caught by data/ and *.geojson above, so it takes two negations: git cannot
# re-include files inside an excluded **directory**, so the directory is un-excluded first.
!atlas/public/data/
!atlas/public/data/*.geojson
!atlas/public/data/*.json

# Python
__pycache__/
*.pyc
venv/

# OS
.DS_Store
Thumbs.db
